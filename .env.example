# Email-Buddy Configuration
# Copy this file to .env and fill in your values

# ===================
# EMAIL/IMAP SETTINGS
# ===================

# IMAP server configuration
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USE_SSL=true

# Email credentials
# For Gmail: use your email and an app password (not your regular password)
# To create Gmail app password: https://support.google.com/accounts/answer/185833
IMAP_USERNAME=your-email@gmail.com
IMAP_PASSWORD=your-app-password

# Email folders
INBOX_FOLDER=INBOX

# Place category folders under INBOX as subfolders
# e.g., Suspicious becomes INBOX.Suspicious (separator auto-detected from server)
CATEGORY_FOLDERS_UNDER_INBOX=false

# ===================
# LLM PROVIDER SETTINGS
# ===================

# LiteLLM model identifier (provider prefix + model name)
# Examples:
#   ollama/llama3.1:8b           — Ollama (recommended)
#   ollama/gemma3:4b          — Ollama (alternative)
#   openai/google/gemma-2-9b  — LM Studio or any OpenAI-compatible server
#   anthropic/claude-3-haiku  — Anthropic (requires LITELLM_API_KEY)
LITELLM_MODEL=ollama/llama3.1:8b

# API base URL for the LLM provider
# Examples:
#   http://ollama:11434              — Ollama (Docker service name)
#   http://192.168.1.53:1234/v1      — LM Studio (note: /v1 suffix required for OpenAI-compatible)
LITELLM_API_BASE=http://ollama:11434

# API key (set "not-needed" for local providers like Ollama/LM Studio)
LITELLM_API_KEY=not-needed

# Timeout for LLM requests (in seconds)
LITELLM_TIMEOUT=3600

# ===================
# PROCESSING SETTINGS
# ===================

# Number of emails to process at once
EMAIL_LIMIT=5

# How many days back to search for unprocessed emails
EMAIL_FETCH_DAYS=7

# Dry run mode: set to true to test without moving emails
DRY_RUN=false

# Process interval in seconds (0 for one-shot mode)
# 3600 = 1 hour, 1800 = 30 minutes, 0 = run once and exit
PROCESS_INTERVAL=3600

# Enable IMAP IDLE for real-time new-email detection
# When true, the daemon uses IMAP IDLE instead of blind sleep between cycles.
# Falls back to polling if the server doesn't support IDLE.
IDLE_ENABLED=true

# Mark emails as read when moving to newsletter or suspicious folders
MARK_AS_READ_WHEN_MOVE=true

# ===================
# DATABASE SETTINGS
# ===================

# SQLite database path for email tracking
DATABASE_PATH=/app/data/email_buddy.db

# ===================
# LOGGING SETTINGS
# ===================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===================
# EMAIL BACKUP SETTINGS
# ===================

# Save raw .eml backup to disk before moving emails (safety net against data loss)
# When enabled, a copy of each email is saved before the IMAP move operation
EMAIL_BACKUP_ENABLED=false

# Directory for .eml backups (organized by category subfolder)
# e.g., /app/data/emails/spam/abc123.eml
EMAIL_BACKUP_PATH=/app/data/emails

# ===================
# LEARNING SYSTEM SETTINGS
# ===================

# Enable/disable adaptive learning system
LEARNING_ENABLED=true

# How many days to keep learning data (0 = keep forever)
LEARNING_RETENTION_DAYS=0

# Maximum learning context entries to include in prompts
MAX_LEARNING_CONTEXT=10

# ===================
# RETENTION SETTINGS
# ===================

# How many days to keep processed emails in the database (0 = keep forever)
EMAIL_RETENTION_DAYS=365

# ===================
# DAILY SUMMARY SETTINGS
# ===================

# Enable daily email summary (delivered to INBOX via IMAP APPEND)
DAILY_SUMMARY_ENABLED=false

# Hour of day to send the summary (0-23, e.g., 8 = 8:00 AM)
DAILY_SUMMARY_HOUR=8

# Language for the LLM-generated tips section (e.g., English, Italian, French)
DAILY_SUMMARY_LANGUAGE=English

# ===================
# CATEGORIES
# ===================

# Email categories as JSON array. Each category has:
#   name:        unique identifier
#   folder:      IMAP folder to move emails to (empty string = stays in INBOX)
#   threshold:   confidence threshold for classification (0.0-1.0)
#   description: description used by the LLM to understand the category
#   is_default:  true for the fallback category (exactly one required)
#
# NOTE: The actual value must be a single-line JSON string in .env.
# The examples below are formatted across multiple lines for readability only.
#
# Default categories (used if CATEGORIES is not set):
#
# CATEGORIES=[
#   {
#     "name": "spam",
#     "folder": "Junk",
#     "threshold": 0.85,
#     "description": "Unwanted, fraudulent, or malicious emails including phishing, scams, and unsolicited messages"
#   },
#   {
#     "name": "newsletter",
#     "folder": "Newsletters",
#     "threshold": 0.85,
#     "description": "Promotional and marketing emails, company newsletters, and subscription-based content"
#   },
#   {
#     "name": "regular",
#     "folder": "",
#     "threshold": 0.5,
#     "description": "Personal and important emails requiring attention",
#     "is_default": true
#   }
# ]
